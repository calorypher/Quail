<Window
    x:Class="Quail.App.FullSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid" Background="{ThemeResource QuailSurfaceBrush}" Padding="16,0,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <Grid x:Name="AppHeader" Padding="0,0,148,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Image x:Name="FeatherImage" Width="22" Height="22" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="Quail" FontFamily="Segoe UI Variable" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="SettingsButton" Grid.Column="2" Click="OnSettingsClicked" ToolTipService.ToolTip="Settings" Style="{StaticResource QuailIconButtonStyle}">
        <FontIcon Glyph="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
      </Button>
      <Button x:Name="CollapseButton" Grid.Column="3" Click="OnCollapseClicked" ToolTipService.ToolTip="Back to Quick Search" Style="{StaticResource QuailIconButtonStyle}">
        <FontIcon Glyph="&#xE73F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
      </Button>
    </Grid>

    <TextBox x:Name="QueryBox" Grid.Row="1" PlaceholderText="Search files and folders…" FontSize="17" Margin="0,6,0,10" TextChanged="OnSearchInputChanged" KeyDown="OnQueryKeyDown" Style="{StaticResource QuailSearchBoxStyle}" />

    <StackPanel Grid.Row="2" Spacing="8" Margin="0,4,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Type" VerticalAlignment="Center" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
        <ComboBox x:Name="TypeBox" Width="96" SelectedIndex="0" SelectionChanged="OnSearchInputChanged" Style="{StaticResource QuailCompactComboBoxStyle}">
          <ComboBoxItem Content="Any" />
          <ComboBoxItem Content="Files" />
          <ComboBoxItem Content="Folders" />
        </ComboBox>
        <TextBox x:Name="ExtensionBox" Width="128" PlaceholderText="Extension: Any" TextChanged="OnSearchInputChanged" Style="{StaticResource QuailCompactTextBoxStyle}" />
        <Button x:Name="ModifiedFilterButton" Content="Modified: Any" Click="OnModifiedFilterClicked" Style="{StaticResource QuailSecondaryActionButtonStyle}" />
        <Button x:Name="AddFilterButton" Content="Add filter" Click="OnAddFilterClicked" Style="{StaticResource QuailSecondaryActionButtonStyle}" />
        <Button x:Name="ClearFiltersButton" Content="Clear all" Click="OnClearFiltersClicked" Style="{StaticResource QuailTertiaryActionButtonStyle}" />
      </StackPanel>
      <Border x:Name="ModifiedDatePanel" Visibility="Collapsed" Padding="12" Background="{ThemeResource QuailSecondarySurfaceBrush}" BorderBrush="{ThemeResource QuailSubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
        <StackPanel Spacing="8">
          <TextBlock Text="Modified date range" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CalendarDatePicker x:Name="ModifiedFromPicker" Width="180" PlaceholderText="From" DateChanged="OnDateChanged" Style="{StaticResource QuailCompactDatePickerStyle}" />
            <CalendarDatePicker x:Name="ModifiedToPicker" Width="180" PlaceholderText="To" DateChanged="OnDateChanged" Style="{StaticResource QuailCompactDatePickerStyle}" />
            <Button Content="Clear dates" Click="OnClearModifiedDatesClicked" Style="{StaticResource QuailTertiaryActionButtonStyle}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <StackPanel x:Name="AdvancedFiltersPanel" Visibility="Collapsed" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <NumberBox x:Name="MinimumSizeBox" Header="Minimum size" Width="120" SpinButtonPlacementMode="Compact" Minimum="0" ValueChanged="OnNumberChanged" />
          <ComboBox x:Name="MinimumUnitBox" Header="Unit" Width="76" SelectedIndex="1" SelectionChanged="OnSearchInputChanged">
            <ComboBoxItem Content="KB" />
            <ComboBoxItem Content="MB" />
            <ComboBoxItem Content="GB" />
          </ComboBox>
          <NumberBox x:Name="MaximumSizeBox" Header="Maximum size" Width="120" SpinButtonPlacementMode="Compact" Minimum="0" ValueChanged="OnNumberChanged" />
          <ComboBox x:Name="MaximumUnitBox" Header="Unit" Width="76" SelectedIndex="1" SelectionChanged="OnSearchInputChanged">
            <ComboBoxItem Content="KB" />
            <ComboBoxItem Content="MB" />
            <ComboBoxItem Content="GB" />
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <CheckBox x:Name="HiddenBox" Content="Hidden" Click="OnSearchInputChanged" />
          <CheckBox x:Name="SystemBox" Content="System" Click="OnSearchInputChanged" />
          <CheckBox x:Name="ReadOnlyBox" Content="Read-only" Click="OnSearchInputChanged" />
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="ValidationText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="3" Padding="12,0" ColumnSpacing="12" BorderBrush="{ThemeResource QuailSubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="85" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="160" />
      </Grid.ColumnDefinitions>
      <Button x:Name="NameHeaderButton" Content="Name" Tag="Name" Click="OnSortHeaderClicked" HorizontalAlignment="Left" Style="{StaticResource QuailColumnHeaderButtonStyle}" />
      <Button x:Name="PathHeaderButton" Grid.Column="1" Content="Path" Tag="Path" Click="OnSortHeaderClicked" HorizontalAlignment="Left" Style="{StaticResource QuailColumnHeaderButtonStyle}" />
      <TextBlock Grid.Column="2" Text="Kind" FontWeight="SemiBold" VerticalAlignment="Center" />
      <Button x:Name="SizeHeaderButton" Grid.Column="3" Content="Size" Tag="Size" Click="OnSortHeaderClicked" HorizontalAlignment="Left" Style="{StaticResource QuailColumnHeaderButtonStyle}" />
      <Button x:Name="ModifiedHeaderButton" Grid.Column="4" Content="Modified" Tag="Modified" Click="OnSortHeaderClicked" HorizontalAlignment="Left" Style="{StaticResource QuailColumnHeaderButtonStyle}" />
    </Grid>

    <Grid Grid.Row="4">
    <ListView x:Name="ResultsList" SelectionMode="Single" IsItemClickEnabled="False" IsSwipeEnabled="False" DoubleTapped="OnResultDoubleTapped" KeyDown="OnResultsKeyDown" RightTapped="OnResultRightTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="38" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ContextFlyout>
        <MenuFlyout Opening="OnContextMenuOpening">
          <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Click="OnOpenClicked" KeyboardAcceleratorTextOverride="Enter" />
          <MenuFlyoutItem x:Name="RevealMenuItem" Text="Open containing folder" Click="OnRevealClicked" KeyboardAcceleratorTextOverride="Ctrl+Enter" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem x:Name="CopyPathMenuItem" Text="Copy path" Click="OnCopyPathClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
        </MenuFlyout>
      </ListView.ContextFlyout>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="12,5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="85" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource QuailSecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Modified}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="FullKeyStateHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
      <FontIcon x:Name="FullKeyStateIcon" HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
      <TextBlock x:Name="FullKeyStateTitle" HorizontalAlignment="Center" FontFamily="Segoe UI Variable" FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="FullKeyStateDetail" HorizontalAlignment="Center" MaxWidth="390" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Segoe UI Variable" FontSize="12" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
      <Button x:Name="IndexUnavailableSettingsButton" Content="Open Settings" Click="OnIndexUnavailableSettingsClicked" Visibility="Collapsed" Style="{StaticResource QuailSecondaryActionButtonStyle}" />
    </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText" Grid.Row="5" Foreground="{ThemeResource QuailSecondaryTextBrush}" VerticalAlignment="Bottom" />
  </Grid>
</Window>
