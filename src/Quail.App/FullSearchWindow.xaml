<Window
    x:Class="Quail.App.FullSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="RootGrid" Background="{ThemeResource QuailSurfaceBrush}" Padding="16,12,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>

    <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <FontIcon Glyph="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource QuailIconBrush}" VerticalAlignment="Center" />
      <TextBox x:Name="QueryBox" Grid.Column="1" PlaceholderText="Search files and folders…" FontSize="16" VerticalAlignment="Center" TextChanged="OnSearchInputChanged" KeyDown="OnQueryKeyDown" />
      <Button x:Name="CollapseButton" Grid.Column="2" Click="OnCollapseClicked" ToolTipService.ToolTip="Back to Quick Search" Background="Transparent" BorderThickness="0" Padding="8" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE73F;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource QuailSecondaryTextBrush}" />
      </Button>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8" Margin="0,4,0,10">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ComboBox x:Name="TypeBox" Header="Type" Width="110" SelectedIndex="0" SelectionChanged="OnSearchInputChanged">
          <ComboBoxItem Content="All" />
          <ComboBoxItem Content="Files" />
          <ComboBoxItem Content="Folders" />
        </ComboBox>
        <TextBox x:Name="ExtensionBox" Header="Extension" Width="115" PlaceholderText="pdf" TextChanged="OnSearchInputChanged" />
        <ComboBox x:Name="SortBox" Header="Sort" Width="130" SelectedIndex="0" SelectionChanged="OnSortChanged">
          <ComboBoxItem Content="Relevance" />
          <ComboBoxItem Content="Name" />
          <ComboBoxItem Content="Path" />
          <ComboBoxItem Content="Size" />
          <ComboBoxItem Content="Modified" />
        </ComboBox>
        <ToggleButton x:Name="SortDirectionButton" Content="Default" MinWidth="105" VerticalAlignment="Bottom" IsEnabled="False" Click="OnSortDirectionChanged" />
        <Button Content="Clear filters" VerticalAlignment="Bottom" Click="OnClearFiltersClicked" Style="{StaticResource QuailTertiaryActionButtonStyle}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <NumberBox x:Name="MinimumSizeBox" Header="Minimum size" Width="120" SpinButtonPlacementMode="Compact" Minimum="0" ValueChanged="OnNumberChanged" />
        <ComboBox x:Name="MinimumUnitBox" Header="Unit" Width="76" SelectedIndex="1" SelectionChanged="OnSearchInputChanged">
          <ComboBoxItem Content="KB" />
          <ComboBoxItem Content="MB" />
          <ComboBoxItem Content="GB" />
        </ComboBox>
        <NumberBox x:Name="MaximumSizeBox" Header="Maximum size" Width="120" SpinButtonPlacementMode="Compact" Minimum="0" ValueChanged="OnNumberChanged" />
        <ComboBox x:Name="MaximumUnitBox" Header="Unit" Width="76" SelectedIndex="1" SelectionChanged="OnSearchInputChanged">
          <ComboBoxItem Content="KB" />
          <ComboBoxItem Content="MB" />
          <ComboBoxItem Content="GB" />
        </ComboBox>
        <CalendarDatePicker x:Name="ModifiedFromPicker" Header="Modified from" Width="165" DateChanged="OnDateChanged" />
        <CalendarDatePicker x:Name="ModifiedToPicker" Header="Modified to" Width="165" DateChanged="OnDateChanged" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="14">
        <CheckBox x:Name="HiddenBox" Content="Hidden" VerticalAlignment="Bottom" Click="OnSearchInputChanged" />
        <CheckBox x:Name="SystemBox" Content="System" VerticalAlignment="Bottom" Click="OnSearchInputChanged" />
        <CheckBox x:Name="ReadOnlyBox" Content="Read-only" VerticalAlignment="Bottom" Click="OnSearchInputChanged" />
        <TextBlock x:Name="ValidationText" VerticalAlignment="Bottom" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="12" BorderBrush="{ThemeResource QuailSubtleBorderBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="4*" />
        <ColumnDefinition Width="85" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="160" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="Path" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="2" Text="Kind" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock Grid.Column="4" Text="Modified" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>

    <ListView x:Name="ResultsList" Grid.Row="3" SelectionMode="Single" IsItemClickEnabled="False" IsSwipeEnabled="False" DoubleTapped="OnResultDoubleTapped" KeyDown="OnResultsKeyDown" RightTapped="OnResultRightTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="38" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ContextFlyout>
        <MenuFlyout Opening="OnContextMenuOpening">
          <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Click="OnOpenClicked" />
          <MenuFlyoutItem x:Name="RevealMenuItem" Text="Open containing folder" Click="OnRevealClicked" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem x:Name="CopyPathMenuItem" Text="Copy path" Click="OnCopyPathClicked" />
        </MenuFlyout>
      </ListView.ContextFlyout>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid Padding="12,5" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="4*" />
              <ColumnDefinition Width="85" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource QuailSecondaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Modified}" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{ThemeResource QuailSecondaryTextBrush}" VerticalAlignment="Bottom" />
  </Grid>
</Window>
